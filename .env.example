# Copy this file to .env and fill in the values. .env is gitignored.
#
# This app targets Adyen's TEST environment only. Use test credentials.

# ── Adyen credentials ────────────────────────────────────────────────────────
# Customer Area → Developers → API credentials
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
# Same screen, under "Client key". A test client key starts with test_.
#
# IMPORTANT: the client key only works on origins you have whitelisted. In the
# Customer Area, next to the client key, use "Add allowed origins" to add the
# exact origin you serve this app from, for example:
#   https://localhost:3000
# Match the scheme and port exactly. http:// and https:// are different origins,
# and so are ports 3000 and 8080. Miss this and Drop-in fails to load.
ADYEN_CLIENT_KEY=

# ── Access gate ──────────────────────────────────────────────────────────────
# The whole app sits behind one shared access code.
#
# Store a bcrypt hash of the code, never the code itself. To generate one:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" 'your-access-code'
#
# The hash contains $ characters, so wrap the value in single quotes.
ACCESS_CODE_HASH=

# Signs the session cookie, so it must be unguessable: anyone who knows this
# value can forge a valid session and walk past the access gate. Generate it,
# do not invent it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing this invalidates every existing session.
SESSION_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Adds a "check webhook status" link to the result screen. Blank hides it.
WEBHOOK_STATUS_URL=

# Defaults to 3000.
PORT=
